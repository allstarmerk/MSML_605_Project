import numpy as np

pairs  = np.load('data/pairs/train_pairs.npy')
labels = np.load('data/pairs/train_labels.npy')

print('pairs shape:', pairs.shape)
print('labels shape:', labels.shape)
print('positive pairs:', labels.sum())
print('negative pairs:', (labels == 0).sum())
print('first 10 pairs:', pairs[:10])
print('first 10 labels:', labels[:10])

print('Image A vector:', pairs[:,0])
